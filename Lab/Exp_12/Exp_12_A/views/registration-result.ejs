<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Registration Successful</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 600px; margin: 50px auto; padding: 20px; }
    .card { background: #e8f5e9; border: 1px solid #c8e6c9; padding: 30px; border-radius: 8px; }
    h1 { color: #2e7d32; margin-top: 0; }
    .item { margin: 12px 0; font-size: 16px; }
    .label { font-weight: bold; color: #1b5e20; }
    .btn { display: inline-block; margin-top: 15px; margin-right: 10px; padding: 10px 15px; background: #2e7d32; color: white; text-decoration: none; border-radius: 4px; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Student Registered Successfully!</h1>
    <div class="item"><span class="label">Assigned ID:</span> <%= student.id %></div>
    <div class="item"><span class="label">Name:</span> <%= student.name %></div>
    <div class="item"><span class="label">Email:</span> <%= student.email %></div>
    <div class="item"><span class="label">Course:</span> <%= student.course %></div>
    <div class="item"><span class="label">Semester:</span> <%= student.semester %></div>
    <a href="/register-student" class="btn">Register Another</a>
    <a href="/students" class="btn" style="background:#0066cc;">View JSON List</a>
  </div>
</body>
</html>