<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Todo App — Docker Persistent Storage | <%= student.name %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Top Header / Student Metadata Bar -->
  <header class="exam-banner">
    <div class="wrap header-flex">
      <div class="branding">
        <span class="exam-tag">END TERM EXAMINATION</span>
        <h1>Containerized Todo Application</h1>
      </div>
      <div class="student-meta">
        <p><strong>Student:</strong> <%= student.name %></p>
        <p><strong>SAP ID:</strong> <span class="badge-sap"><%= student.sapId %></span></p>
        <p><strong>Course:</strong> <%= student.course %></p>
      </div>
    </div>
  </header>

  <main class="wrap main-content">

    <!-- Persistence Status Card -->
    <section class="card persistence-bar">
      <div class="persistence-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
          <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
          <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
        </svg>
      </div>
      <div class="persistence-info">
        <h3>Docker Volume Storage Active</h3>
        <p class="file-path">
          <strong>Mounted Path:</strong> <code><%= dataFile %></code>
        </p>
        <p class="persistence-desc">
          Data is saved to the mounted volume directory on the host machine. Even if this container is stopped, deleted, or the Docker image is removed, all tasks remain safely preserved on host disk.
        </p>
      </div>
      <div class="stats-pills">
        <div class="stat-box">
          <span class="stat-num"><%= stats.total %></span>
          <span class="stat-lbl">Total Tasks</span>
        </div>
        <div class="stat-box stat-active">
          <span class="stat-num"><%= stats.active %></span>
          <span class="stat-lbl">Active</span>
        </div>
        <div class="stat-box stat-done">
          <span class="stat-num"><%= stats.completed %></span>
          <span class="stat-lbl">Completed</span>
        </div>
      </div>
    </section>

    <!-- Create Task Form -->
    <section class="card form-card">
      <h2>Add New Task</h2>
      <form action="/todos/add" method="POST" class="todo-form">
        <div class="form-row">
          <div class="form-group flex-2">
            <label for="title">Task Title</label>
            <input type="text" id="title" name="title" placeholder="e.g. Test Docker volume persistence..." required autofocus>
          </div>
          <div class="form-group flex-1">
            <label for="category">Category</label>
            <select id="category" name="category">
              <option value="DevOps">DevOps</option>
              <option value="Docker">Docker</option>
              <option value="Testing">Testing</option>
              <option value="Backend">Backend</option>
              <option value="General">General</option>
            </select>
          </div>
          <div class="form-group flex-1">
            <label for="priority">Priority</label>
            <select id="priority" name="priority">
              <option value="High">High</option>
              <option value="Medium" selected>Medium</option>
              <option value="Low">Low</option>
            </select>
          </div>
          <div class="form-group btn-col">
            <button type="submit" class="btn btn-primary">+ Create Task</button>
          </div>
        </div>
      </form>
    </section>

    <!-- Task List & Filters -->
    <section class="card list-card">
      <div class="list-header">
        <h2>Tasks List (<%= todos.length %>)</h2>
        <div class="filter-pills">
          <a href="/?filter=all" class="pill <%= currentFilter === 'all' ? 'active' : '' %>">All (<%= stats.total %>)</a>
          <a href="/?filter=active" class="pill <%= currentFilter === 'active' ? 'active' : '' %>">Active (<%= stats.active %>)</a>
          <a href="/?filter=completed" class="pill <%= currentFilter === 'completed' ? 'active' : '' %>">Completed (<%= stats.completed %>)</a>
        </div>
      </div>

      <% if (todos.length === 0) { %>
        <div class="empty-state">
          <p>No tasks found for filter "<strong><%= currentFilter %></strong>". Add a new task above!</p>
        </div>
      <% } else { %>
        <ul class="task-list">
          <% todos.forEach(todo => { %>
            <li class="task-item <%= todo.completed ? 'is-completed' : '' %>">
              <div class="task-left">
                <form action="/todos/toggle/<%= todo.id %>" method="POST" style="display:inline;">
                  <button type="submit" class="toggle-btn" title="Toggle completion">
                    <% if (todo.completed) { %>
                      <span class="check-box checked">&#10003;</span>
                    <% } else { %>
                      <span class="check-box"></span>
                    <% } %>
                  </button>
                </form>
                <div class="task-details">
                  <span class="task-title <%= todo.completed ? 'strikethrough' : '' %>"><%= todo.title %></span>
                  <div class="task-meta">
                    <span class="meta-tag tag-cat"><%= todo.category %></span>
                    <span class="meta-tag tag-prio tag-<%= todo.priority.toLowerCase() %>"><%= todo.priority %></span>
                    <span class="meta-date">ID #<%= todo.id %> &bull; <%= new Date(todo.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
                  </div>
                </div>
              </div>
              <div class="task-actions">
                <form action="/todos/delete/<%= todo.id %>" method="POST" onsubmit="return confirm('Delete task #<%= todo.id %>?');" style="display:inline;">
                  <button type="submit" class="btn btn-delete" title="Delete task">&times; Delete</button>
                </form>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

  </main>

  <footer class="site-footer wrap">
    <p>Final Examination Submission &bull; <strong><%= student.name %></strong> (SAP ID: <strong><%= student.sapId %></strong>) &bull; UPES Dehradun</p>
    <p class="footer-links">
      <a href="/health" target="_blank">Health Check API</a>
      &bull;
      <a href="/api/todos" target="_blank">JSON REST API</a>
    </p>
  </footer>

</body>
</html>
